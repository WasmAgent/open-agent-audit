{
  "name": "@openagentaudit/adapters",
  "version": "0.5.2",
  "description": "Source-format adapters: AEP, ComplianceEvalRecord, bscode, OTel, Langfuse, LangSmith",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./aep-v0_2": {
      "import": "./dist/aep-v0_2.js",
      "types": "./dist/aep-v0_2.d.ts"
    },
    "./bscode": {
      "import": "./dist/bscode.js",
      "types": "./dist/bscode.d.ts"
    },
    "./otel": {
      "import": "./dist/otel.js",
      "types": "./dist/otel.d.ts"
    },
    "./langfuse": {
      "import": "./dist/langfuse.js",
      "types": "./dist/langfuse.d.ts"
    },
    "./langsmith": {
      "import": "./dist/langsmith.js",
      "types": "./dist/langsmith.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test ./src",
    "clean": "rm -rf dist .turbo",
    "prepublishOnly": "npm run build"
  },
  "wasmagent": {
    "stability": "alpha"
  },
  "dependencies": {
    "@openagentaudit/schema": "0.5.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
