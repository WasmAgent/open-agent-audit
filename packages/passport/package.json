{
  "name": "@openagentaudit/passport",
  "version": "0.4.0",
  "description": "Trust Passport: signed audit certificates for AI agents",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
